{
  "kind": "advanced",
  "highlighter": {
    "langs": [
      "js",
      "markdown",
      {
        "name": "test-empty-match",
        "scopeName": "source.test-empty-match",
        "patterns": [
          {
            "match": "",
            "name": "invalid"
          },
          {
            "match": "hello",
            "name": "keyword"
          }
        ]
      },
      {
        "name": "test-while",
        "scopeName": "source.test-while",
        "patterns": [
          {
            "begin": "^(>)( ?)",
            "while": "^(>)( ?)",
            "name": "markup.quote",
            "contentName": "meta.content",
            "beginCaptures": {
              "1": {
                "name": "punctuation.definition.quote"
              }
            },
            "whileCaptures": {
              "1": {
                "name": "punctuation.definition.quote"
              }
            },
            "patterns": [
              {
                "match": "\\b\\d+\\b",
                "name": "constant.numeric"
              }
            ]
          },
          {
            "match": "\\b\\w+\\b",
            "name": "keyword.control"
          }
        ]
      },
      {
        "name": "test-backref",
        "scopeName": "source.test-backref",
        "patterns": [
          {
            "begin": "<<([A-Z]+)",
            "end": "^\\1$",
            "name": "string.heredoc.$1",
            "contentName": "meta.heredoc.${1:/downcase}",
            "beginCaptures": {
              "1": {
                "name": "entity.name.tag"
              }
            },
            "endCaptures": {
              "0": {
                "name": "entity.name.tag"
              }
            },
            "patterns": [
              {
                "match": "\\$\\w+",
                "name": "variable.other"
              }
            ]
          },
          {
            "match": "(\\w+)(:)(.*)$",
            "name": "meta.assignment",
            "captures": {
              "1": {
                "name": "variable.other"
              },
              "2": {
                "name": "punctuation.separator"
              },
              "3": {
                "patterns": [
                  {
                    "match": "\\d+",
                    "name": "constant.numeric"
                  },
                  {
                    "match": "\"[^\"]*\"",
                    "name": "string.quoted"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "name": "test-inject",
        "scopeName": "source.test-inject",
        "patterns": [
          {
            "begin": "/\\*",
            "end": "\\*/",
            "name": "comment.block"
          },
          {
            "match": "\\w+",
            "name": "variable.other"
          }
        ],
        "injections": {
          "L:comment - comment.block.ignored": {
            "match": "\\bTODO\\b",
            "name": "keyword.other.todo"
          },
          "R:source.test-inject": {
            "match": "right",
            "name": "constant.language"
          }
        }
      },
      {
        "name": "test-external",
        "scopeName": "source.test-external",
        "injectTo": [
          "source.test-inject"
        ],
        "injectionSelector": "L:comment",
        "patterns": [
          {
            "match": "FIXME",
            "name": "invalid.illegal"
          }
        ]
      },
      {
        "name": "test-end-last",
        "scopeName": "source.test-end-last",
        "patterns": [
          {
            "begin": "\\[",
            "end": "\\]",
            "applyEndPatternLast": true,
            "name": "meta.square",
            "patterns": [
              {
                "match": "\\]\\]",
                "name": "constant.character.escape"
              }
            ]
          },
          {
            "begin": "\\(",
            "end": "\\)",
            "name": "meta.round",
            "patterns": [
              {
                "match": "\\)\\)",
                "name": "constant.character.escape"
              }
            ]
          }
        ]
      },
      {
        "name": "test-zero",
        "scopeName": "source.test-zero",
        "patterns": [
          {
            "begin": "(?=a)",
            "end": "(?=b)",
            "name": "meta.zero",
            "patterns": [
              {
                "match": "a+",
                "name": "keyword"
              }
            ]
          },
          {
            "match": "b+",
            "name": "constant"
          },
          {
            "match": "(?=x)",
            "name": "invalid"
          }
        ]
      }
    ],
    "themes": [
      "github-dark",
      "github-light",
      {
        "name": "custom-invalid",
        "settings": [
          {
            "settings": {
              "foreground": "#12345",
              "background": "#xyz"
            }
          },
          {
            "scope": "keyword",
            "settings": {
              "foreground": "#abcdefg"
            }
          }
        ]
      },
      {
        "name": "custom-css",
        "type": "light",
        "colors": {
          "editor.foreground": "#00000001",
          "editor.background": "#00000002",
          "terminal.ansiRed": "#00000004"
        },
        "tokenColors": [
          {
            "settings": {
              "foreground": "var(--fg)",
              "background": "var(--bg)"
            }
          },
          {
            "scope": "keyword",
            "settings": {
              "foreground": "var(--kw)",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "string",
            "settings": {
              "foreground": "var(--fg)"
            }
          }
        ]
      },
      {
        "name": "custom-replace",
        "settings": [
          {
            "settings": {
              "foreground": "#123456",
              "background": "#abcdef"
            }
          },
          {
            "scope": "keyword",
            "settings": {
              "foreground": "#654321"
            }
          }
        ],
        "colorReplacements": {
          "#123456": "var(--fg)",
          "#abcdef": "var(--bg)",
          "#654321": "var(--kw)"
        }
      }
    ]
  },
